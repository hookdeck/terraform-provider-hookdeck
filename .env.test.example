# Test environment variables for Terraform acceptance tests
# Copy this file to .env.test and fill in your values

# Enable acceptance tests
TF_ACC=1

# Organization API key for testing, with the projects.write, api-keys.write and
# gateway.* scopes. This is the only credential the tests need. They use two
# projects named tf-ci-a and tf-ci-b in the organization and create them when
# they are missing.
HOOKDECK_ORG_API_KEY=hd_org_your_key_here

# Optional: client rate limit for the tests, in requests per minute per test
# process (default 2000). Lower it if your organization's API rate limit is
# lower (240 by default).
# HOOKDECK_TEST_REQUESTS_PER_MINUTE=240

# Optional: Set API base URL for testing against different environments
# HOOKDECK_API_BASE=https://api.hookdeck.com
