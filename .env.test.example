# Test environment variables for Terraform acceptance tests
# Copy this file to .env.test and fill in your values

# Enable acceptance tests
TF_ACC=1

# Your Hookdeck API key for testing
HOOKDECK_API_KEY=your_api_key_here

# Optional: Set API base URL for testing against different environments
# HOOKDECK_API_BASE=https://api.hookdeck.com

# Optional: organization API key tests. They skip when these are unset.
# The key needs projects.write and the gateway scopes, and access to
# HOOKDECK_ORG_PROJECT_ID. The tests create and delete projects in its
# organization on every run. TestAccProjectScope_KeyCannotReachStoredProject
# skips when HOOKDECK_API_KEY belongs to HOOKDECK_ORG_PROJECT_ID: it needs a
# project key for another project.
# HOOKDECK_ORG_API_KEY=hd_org_your_key_here
# HOOKDECK_ORG_PROJECT_ID=tm_your_project_id
